---
import Layout from "../layouts/Layout.astro";
import AuthorCard from "../components/AuthorCard.astro";
import ArticleCard from "../components/ArticleCard.astro";
import StayCard from "../components/StayCard.astro";
import BrushUnderline from "../components/decorations/BrushUnderline.astro";
import DashedDivider from "../components/decorations/DashedDivider.astro";
import Icons from "../components/icons/Icons.astro";
import {
  getAllArticles,
  slugOf,
  countryLabel,
} from "../lib/articles";
import { stays, getActiveDeals } from "../data/stays";
import { site } from "../data/site";

const articles = await getAllArticles();
const latestArticles = articles
  .filter((a) => a.data.type !== "stay")
  .slice(0, 6);
const activeDeals = getActiveDeals();

const japanCount = articles.filter((a) => a.data.country === "japan").length;
const taiwanCount = articles.filter((a) => a.data.country === "taiwan").length;
---

<Layout>
  <section class="mx-auto max-w-6xl px-4 pt-10 pb-14 md:pt-16 md:pb-20">
    <div class="grid gap-10 md:grid-cols-[1fr_320px] md:gap-12">
      <div>
        <p class="text-sm tracking-widest text-brand-teal uppercase">
          Tina's Travel &amp; Living
        </p>

        <h1 class="mt-4 font-display text-5xl leading-tight md:text-7xl">
          跟著黃踢那出發吧！
        </h1>
        <BrushUnderline class="mt-2 max-w-md" />

        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-700">
          每次更新，都可能是你的下一趟旅行。日本、台灣的真實旅行體驗、
          自由行攻略、住宿心得與行前準備。
        </p>

        <div class="mt-10 flex flex-wrap gap-3">
          <a
            href="/articles"
            class="rounded-full bg-brand-orange px-5 py-2.5 text-sm font-medium text-brand-brown shadow-sm transition hover:brightness-95"
          >
            看最新攻略
          </a>
          <a
            href="/stays"
            class="rounded-full border border-brand-brown px-5 py-2.5 text-sm font-medium text-brand-brown transition hover:bg-brand-brown hover:text-brand-cream"
          >
            看住過的旅宿
          </a>
        </div>
      </div>

      <aside class="hidden md:block">
        <AuthorCard />
      </aside>
    </div>
  </section>

  {
    latestArticles.length > 0 && (
      <section class="border-t border-border-soft bg-paper-soft">
        <div class="mx-auto max-w-6xl px-4 py-14 md:py-20">
          <div class="flex items-end justify-between gap-4">
            <div>
              <p class="text-xs tracking-widest text-ink-500 uppercase">
                Latest
              </p>
              <h2 class="mt-1 text-2xl font-bold text-brand-brown md:text-3xl">
                最新攻略
              </h2>
            </div>
            <a
              href="/articles"
              class="shrink-0 text-sm text-brand-brown underline-offset-4 hover:underline"
            >
              看全部 →
            </a>
          </div>

          <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {latestArticles.map((a) => (
              <ArticleCard
                title={a.data.title}
                slug={slugOf(a)}
                cover={a.data.cover}
                excerpt={a.data.excerpt}
                city={a.data.city}
                country={a.data.country}
                status={a.data.status}
                date={a.data.date.toISOString()}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    stays.length > 0 && (
      <section class="border-t border-border-soft">
        <div class="mx-auto max-w-6xl px-4 py-14 md:py-20">
          <div class="flex items-end justify-between gap-4">
            <div>
              <p class="text-xs tracking-widest text-ink-500 uppercase">
                Stays
              </p>
              <h2 class="mt-1 text-2xl font-bold text-brand-brown md:text-3xl">
                黃踢那住過的地方
              </h2>
              {activeDeals.length > 0 && (
                <p class="mt-2 text-xs text-ink-500">
                  目前有 {activeDeals.length} 個粉絲專屬優惠進行中
                </p>
              )}
            </div>
            <a
              href="/stays"
              class="shrink-0 text-sm text-brand-brown underline-offset-4 hover:underline"
            >
              看全部 →
            </a>
          </div>

          <div class="mt-8 grid gap-6 md:grid-cols-2">
            {stays.slice(0, 2).map((s) => (
              <StayCard stay={s} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="border-t border-border-soft bg-paper-soft">
    <div class="mx-auto max-w-6xl px-4 py-14 md:py-20">
      <p class="text-xs tracking-widest text-ink-500 uppercase">Destinations</p>
      <h2 class="mt-1 text-2xl font-bold text-brand-brown md:text-3xl">
        依地區逛
      </h2>

      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <a
          href="/japan"
          class="group block rounded-2xl border border-border-soft bg-brand-cream p-6 transition hover:border-brand-brown/30"
        >
          <p class="text-xs text-ink-500">🇯🇵 Japan</p>
          <h3 class="mt-2 text-xl font-bold text-brand-brown group-hover:text-brand-orange">
            日本
          </h3>
          <p class="mt-2 text-sm text-ink-700">
            {japanCount > 0
              ? `${japanCount} 篇攻略，從京都到北海道`
              : "更多攻略陸續上線中"}
          </p>
          <p class="mt-4 text-sm text-brand-brown underline-offset-4 group-hover:underline">
            逛日本 →
          </p>
        </a>

        <a
          href="/taiwan"
          class="group block rounded-2xl border border-border-soft bg-brand-cream p-6 transition hover:border-brand-brown/30"
        >
          <p class="text-xs text-ink-500">🇹🇼 Taiwan</p>
          <h3 class="mt-2 text-xl font-bold text-brand-brown group-hover:text-brand-orange">
            台灣
          </h3>
          <p class="mt-2 text-sm text-ink-700">
            {taiwanCount > 0
              ? `${taiwanCount} 篇攻略，宜蘭、苗栗、更多縣市陸續補`
              : "更多攻略陸續上線中"}
          </p>
          <p class="mt-4 text-sm text-brand-brown underline-offset-4 group-hover:underline">
            逛台灣 →
          </p>
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-border-soft">
    <div class="mx-auto max-w-6xl px-4 py-14 md:py-20">
      <p class="text-xs tracking-widest text-ink-500 uppercase">Prepare</p>
      <h2 class="mt-1 text-2xl font-bold text-brand-brown md:text-3xl">
        行前準備中心
      </h2>
      <p class="mt-3 max-w-2xl text-sm text-ink-700">
        日本自由行必備的網路、交通、票券、退稅資訊整理。這一區會隨著實際使用慢慢補齊。
      </p>
      <a
        href="/prepare"
        class="mt-5 inline-block text-sm text-brand-brown underline-offset-4 hover:underline"
      >
        看行前準備 →
      </a>
    </div>
  </section>

  <section class="border-t border-border-soft bg-brand-brown text-brand-cream">
    <div class="mx-auto max-w-4xl px-4 py-14 text-center md:py-20">
      <p class="text-xs tracking-widest text-brand-orange uppercase">
        Join
      </p>
      <h2 class="mt-2 font-display text-3xl md:text-5xl">
        下一趟旅行，不要漏掉。
      </h2>
      <p class="mt-5 text-sm leading-relaxed text-brand-cream/80">
        追 IG 看最新 Reels、加 LINE 社群拿旅宿優惠。
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <a
          href={site.social.lineCommunity}
          target="_blank"
          rel="noopener noreferrer"
          data-ga-event="join_line"
          data-ga-label="homepage_join_section"
          class="inline-flex items-center gap-2 rounded-full bg-brand-teal px-5 py-2.5 text-sm font-medium text-brand-cream transition hover:brightness-95"
        >
          <Icons name="line" size={18} />
          加入 LINE 社群
        </a>
        <a
          href={site.social.instagram}
          target="_blank"
          rel="noopener noreferrer"
          data-ga-event="follow_ig"
          data-ga-label="homepage_join_section"
          class="inline-flex items-center gap-2 rounded-full bg-brand-orange px-5 py-2.5 text-sm font-medium text-brand-brown transition hover:brightness-95"
        >
          <Icons name="instagram" size={18} />
          追蹤 IG
        </a>
      </div>
    </div>
  </section>
</Layout>
