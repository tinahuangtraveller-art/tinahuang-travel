---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getAllArticles, slugOf } from "../../lib/articles";
import { themes, getArticlesByTheme } from "../../lib/themes";

export async function getStaticPaths() {
  const articles = await getAllArticles();
  return themes.map((theme) => ({
    params: { theme: theme.slug },
    props: {
      theme,
      articles: getArticlesByTheme(articles, theme),
    },
  }));
}

const { theme, articles } = Astro.props;
---

<Layout
  title={`${theme.label}｜主題攻略`}
  description={theme.description}
>
  <section class="mx-auto max-w-6xl px-4 pt-10 pb-16 md:pt-14">
    <nav class="text-xs tracking-widest text-ink-500 uppercase" aria-label="麵包屑">
      <a href="/themes" class="hover:text-brand-orange">Themes</a>
      <span class="mx-1">›</span>
      <span>{theme.label}</span>
    </nav>

    <h1 class="mt-2 text-3xl font-bold text-brand-brown md:text-4xl">
      {theme.emoji} {theme.label}
    </h1>
    <p class="mt-4 max-w-2xl text-sm text-ink-700">{theme.description}</p>
    <p class="mt-2 text-xs text-ink-500">目前共 {articles.length} 篇。</p>

    {
      articles.length > 0 ? (
        <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {articles.map((a) => (
            <ArticleCard
              title={a.data.title}
              slug={slugOf(a)}
              cover={a.data.cover}
              coverFocal={a.data.coverFocal}
              excerpt={a.data.excerpt}
              city={a.data.city}
              country={a.data.country}
              status={a.data.status}
              date={a.data.date.toISOString()}
              position="theme_page"
            />
          ))}
        </div>
      ) : (
        <div class="mt-16 rounded-2xl border border-dashed border-border-soft bg-paper-soft p-8 text-center">
          <p class="text-sm text-ink-700">
            {theme.label}主題的攻略還在整理中，很快回來看。
          </p>
          <a
            href="/articles"
            class="mt-4 inline-block text-sm text-brand-brown underline-offset-4 hover:underline"
          >
            先逛其他攻略 →
          </a>
        </div>
      )
    }
  </section>
</Layout>
