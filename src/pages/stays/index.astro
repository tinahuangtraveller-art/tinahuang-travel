---
import Layout from "../../layouts/Layout.astro";
import StayCard from "../../components/StayCard.astro";
import { stays, getActiveDeals } from "../../data/stays";

const activeDeals = getActiveDeals();
const japanStays = stays.filter((s) => s.country === "japan");
const taiwanStays = stays.filter((s) => s.country === "taiwan");
---

<Layout title="住過的地方" description="黃踢那實住的台日旅宿心得與粉絲專屬優惠。">
  <section class="mx-auto max-w-6xl px-4 pt-10 pb-16 md:pt-14">
    <p class="text-xs tracking-widest text-ink-500 uppercase">Stays</p>
    <h1 class="mt-2 text-3xl font-bold text-brand-brown md:text-4xl">
      🏨 住過的地方
    </h1>
    <p class="mt-4 max-w-2xl text-sm text-ink-700">
      每一間都是我真的去住過的。有合作的會標示粉絲專屬優惠。
      {activeDeals.length > 0 &&
        `目前有 ${activeDeals.length} 個優惠進行中。`}
    </p>

    {
      taiwanStays.length > 0 && (
        <section class="mt-10">
          <h2 class="text-xl font-bold text-brand-brown md:text-2xl">
            🇹🇼 台灣
          </h2>
          <div class="mt-6 grid gap-6 md:grid-cols-2">
            {taiwanStays.map((s) => (
              <StayCard stay={s} />
            ))}
          </div>
        </section>
      )
    }

    {
      japanStays.length > 0 && (
        <section class="mt-14">
          <h2 class="text-xl font-bold text-brand-brown md:text-2xl">
            🇯🇵 日本
          </h2>
          <div class="mt-6 grid gap-6 md:grid-cols-2">
            {japanStays.map((s) => (
              <StayCard stay={s} />
            ))}
          </div>
        </section>
      )
    }

    {
      stays.length === 0 && (
        <p class="mt-16 text-center text-ink-500">
          住宿心得準備中，很快回來看
        </p>
      )
    }

    <p class="mt-14 text-[11px] leading-relaxed text-ink-500">
      ✱ 標示「粉絲專屬」的卡片包含商業合作連結，不影響你的購買價格。
      所有住宿都是黃踢那實際入住後的心得。
    </p>
  </section>
</Layout>
