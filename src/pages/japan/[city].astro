---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import StayCard from "../../components/StayCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import {
  getArticlesByCountry,
  slugOf,
  groupByCity,
} from "../../lib/articles";
import { getThemesWithCounts } from "../../lib/themes";
import { stays } from "../../data/stays";

export async function getStaticPaths() {
  const articles = await getArticlesByCountry("japan");
  const byCity = groupByCity(articles);
  const cities = Array.from(byCity.keys()).filter((c) => c !== "其他");
  return cities.map((city) => ({
    params: { city },
    props: { city, articles: byCity.get(city) ?? [] },
  }));
}

const { city, articles } = Astro.props;
const cityStays = stays.filter(
  (s) => s.country === "japan" && s.city === city
);
const cityThemes = getThemesWithCounts(articles).filter((t) => t.count > 0);
---

<Layout title={`${city}｜日本`} description={`黃踢那在日本 ${city} 的旅行紀錄。`}>
  <section class="mx-auto max-w-6xl px-4 pt-6 pb-16 md:pt-8">
    <Breadcrumbs
      items={[
        { label: "首頁", href: "/" },
        { label: "日本", href: "/japan" },
        { label: city },
      ]}
      className="mb-5"
    />

    <h1 class="text-3xl font-bold text-brand-brown md:text-4xl">
      📍 {city}
    </h1>
    <p class="mt-4 max-w-2xl text-sm text-ink-700">
      {city} 共 {articles.length} 篇攻略。
    </p>

    {
      cityThemes.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          {cityThemes.map((t) => (
            <a
              href={`/themes/${t.slug}`}
              class="inline-flex items-center gap-1.5 rounded-full border border-border-soft bg-brand-cream px-3 py-1.5 text-xs text-brand-brown transition hover:border-brand-brown"
            >
              <span aria-hidden="true">{t.emoji}</span>
              {t.label}
              <span class="text-ink-500">{t.count}</span>
            </a>
          ))}
        </div>
      )
    }

    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {articles.map((a) => (
        <ArticleCard
          title={a.data.title}
          slug={slugOf(a)}
          cover={a.data.cover}
          excerpt={a.data.excerpt}
          city={a.data.city}
          country={a.data.country}
          status={a.data.status}
          date={a.data.date.toISOString()}
        />
      ))}
    </div>

    {
      cityStays.length > 0 && (
        <section class="mt-14 border-t border-border-soft pt-14">
          <h2 class="text-xl font-bold text-brand-brown md:text-2xl">
            住過的地方
          </h2>
          <div class="mt-6 grid gap-6 md:grid-cols-2">
            {cityStays.map((s) => (
              <StayCard stay={s} />
            ))}
          </div>
        </section>
      )
    }
  </section>
</Layout>
