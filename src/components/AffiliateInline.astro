---
import { getEntry } from "astro:content";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const entry = await getEntry("affiliates", slug);
const data = entry?.data;
const title = data?.title ?? slug;
const platformLabel =
  data?.platform === "klook"
    ? "Klook"
    : data?.platform === "kkday"
      ? "KKday"
      : "合作平台";
---

{
  data?.url ? (
    <a
      href={data.url}
      target="_blank"
      rel="noopener noreferrer sponsored"
      class="affiliate-cta"
      data-affiliate={slug}
      data-ga-event="affiliate_click"
      data-ga-label={slug}
    >
      <span aria-hidden="true">🎟️</span>
      <span class="affiliate-cta__title">{title}</span>
      <span class="affiliate-cta__platform">{platformLabel} ↗</span>
    </a>
  ) : (
    <span class="affiliate-pending" data-affiliate={slug}>
      <span aria-hidden="true">🎟️</span>
      <span class="affiliate-pending__title">{title}</span>
      <span class="affiliate-pending__note">合作連結整理中</span>
    </span>
  )
}
