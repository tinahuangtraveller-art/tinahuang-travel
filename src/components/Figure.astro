---
interface Props {
  src?: string;
  alt?: string;
  size?: "sm" | "md" | "lg" | "full";
  align?: "left" | "right" | "center";
  caption?: string;
}

const {
  src,
  alt = "",
  size = "md",
  align = "center",
  caption,
} = Astro.props;

const classes = `img-${size} img-${align}`;
---

<figure class={classes}>
  {
    src ? (
      <img src={src} alt={alt} loading="lazy" />
    ) : (
      <div class="flex min-h-[180px] items-center justify-center rounded-lg border-2 border-dashed border-border-soft bg-paper-soft text-sm text-ink-500">
        🖼 圖片待補
      </div>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>
