---
interface Props {
  name: string;
  gmaps?: string;
  category?: "attraction" | "food" | "stay" | "transport";
  lat?: number;
  lng?: number;
}

const { name, gmaps, category, lat, lng } = Astro.props;

const categoryIcon: Record<string, string> = {
  attraction: "📍",
  food: "🍽",
  stay: "🏨",
  transport: "🚉",
};

const icon = categoryIcon[category ?? "attraction"] ?? "📍";

const hasCoords = lat != null && lng != null;

const bboxDelta = 0.01;
const osmEmbedSrc = hasCoords
  ? `https://www.openstreetmap.org/export/embed.html?bbox=${lng - bboxDelta},${lat - bboxDelta},${lng + bboxDelta},${lat + bboxDelta}&layer=mapnik&marker=${lat},${lng}`
  : null;

const openUrl =
  gmaps ??
  (hasCoords
    ? `https://www.google.com/maps/search/?api=1&query=${lat},${lng}`
    : null);

const navUrl = hasCoords
  ? `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`
  : openUrl;
---

<figure
  class="place-card my-6 overflow-hidden rounded-2xl border border-border-soft bg-brand-cream"
>
  <figcaption class="flex items-center justify-between gap-3 px-4 py-3">
    <span class="flex items-center gap-2 text-sm font-medium text-brand-brown">
      <span aria-hidden="true">{icon}</span>
      {name}
    </span>
  </figcaption>

  {
    osmEmbedSrc && (
      <div class="place-map">
        <iframe
          src={osmEmbedSrc}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`${name} 位置預覽`}
          aria-label={`${name} 在 OpenStreetMap 上的位置`}
        />
      </div>
    )
  }

  <div class="flex flex-wrap gap-2 border-t border-border-soft px-4 py-3 text-xs">
    {
      openUrl && (
        <a
          href={openUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-full border border-border-soft bg-brand-cream px-3 py-1.5 text-brand-brown transition hover:border-brand-brown"
        >
          📱 存到我的 Google Maps
        </a>
      )
    }
    {
      navUrl && (
        <a
          href={navUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-full border border-border-soft bg-brand-cream px-3 py-1.5 text-brand-brown transition hover:border-brand-brown"
        >
          🧭 導航
        </a>
      )
    }
  </div>
</figure>

<style>
  .place-map {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--color-paper-soft);
    overflow: hidden;
  }

  .place-map iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
</style>
