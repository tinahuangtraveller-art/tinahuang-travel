---
interface Props {
  title: string;
  slug: string;
  cover?: string;
  excerpt: string;
  city?: string;
  country?: "japan" | "taiwan";
}

const { title, slug, cover, excerpt, city, country } = Astro.props;
const countryLabel = country === "japan" ? "🇯🇵 日本" : country === "taiwan" ? "🇹🇼 台灣" : "";
const location = [countryLabel, city].filter(Boolean).join(" · ");
---

<a
  href={`/articles/${slug}`}
  class="group relative block overflow-hidden rounded-2xl border border-border-soft bg-brand-cream transition hover:border-brand-brown/30"
>
  <div class="grid md:grid-cols-[1.4fr_1fr]">
    <div class="relative aspect-[16/10] md:aspect-auto md:min-h-[260px]">
      {
        cover ? (
          <img
            src={cover}
            alt={title}
            class="h-full w-full object-cover transition group-hover:scale-[1.02]"
            loading="lazy"
          />
        ) : (
          <div class="flex h-full items-center justify-center bg-paper-soft text-sm text-ink-500">
            📰 本月精選
          </div>
        )
      }
      <span
        class="absolute left-3 top-3 inline-flex items-center gap-1 rounded-full bg-brand-orange/95 px-3 py-1 text-xs font-medium text-brand-brown shadow-sm"
      >
        📰 本月精選
      </span>
    </div>

    <div class="flex flex-col justify-center gap-3 p-5 md:p-7">
      {location && <p class="text-xs text-ink-500">{location}</p>}
      <h3 class="text-xl font-semibold leading-snug text-brand-brown md:text-2xl">
        {title}
      </h3>
      <p class="line-clamp-3 text-sm leading-relaxed text-ink-700">
        {excerpt}
      </p>
      <p class="mt-2 text-sm font-medium text-brand-brown underline-offset-4 group-hover:underline">
        看完整攻略 →
      </p>
    </div>
  </div>
</a>
