---
interface Props {
  url: string;
  cover?: string;
  caption?: string;
}

const { url, cover, caption } = Astro.props;

const match = url.match(/instagram\.com\/(reel|reels|p)\/([^/?]+)/);
const kind = match?.[1] ?? "p";
const mediaId = match?.[2] ?? "";
const canonicalUrl = mediaId
  ? `https://www.instagram.com/${kind === "reels" ? "reel" : kind}/${mediaId}/`
  : url;
---

<figure class="ig-reel my-8 overflow-hidden rounded-2xl border border-border-soft bg-brand-cream">
  <a
    href={canonicalUrl}
    target="_blank"
    rel="noopener noreferrer"
    data-ga-event="open_ig_reel"
    data-ga-label={mediaId}
    class="group flex items-stretch gap-4 p-3 transition hover:bg-paper-soft sm:p-4"
  >
    {
      cover ? (
        <div class="relative aspect-[9/16] w-24 shrink-0 overflow-hidden rounded-lg bg-paper-soft sm:w-28">
          <img
            src={cover}
            alt=""
            class="h-full w-full object-cover"
            loading="lazy"
          />
          <span
            class="absolute inset-0 flex items-center justify-center bg-black/10 transition group-hover:bg-black/20"
            aria-hidden="true"
          >
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-brand-cream/95 text-brand-brown shadow-md">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="translate-x-0.5"
              >
                <path d="M8 5v14l11-7z" />
              </svg>
            </span>
          </span>
        </div>
      ) : (
        <div
          class="inline-flex h-20 w-20 shrink-0 items-center justify-center rounded-lg bg-brand-orange/15 text-2xl text-brand-brown sm:h-24 sm:w-24"
          aria-hidden="true"
        >
          📹
        </div>
      )
    }

    <div class="flex min-w-0 flex-1 flex-col justify-center">
      <span class="inline-flex items-center gap-1.5 text-[11px] font-medium tracking-wide text-ink-500">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.9.2 2.4.4.6.2 1 .5 1.5 1 .5.5.8.9 1 1.5.2.5.4 1.2.4 2.4.1 1.2.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.2 1.9-.4 2.4-.2.6-.5 1-1 1.5-.5.5-.9.8-1.5 1-.5.2-1.2.4-2.4.4-1.2.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.9-.2-2.4-.4-.6-.2-1-.5-1.5-1-.5-.5-.8-.9-1-1.5-.2-.5-.4-1.2-.4-2.4C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c.1-1.2.2-1.9.4-2.4.2-.6.5-1 1-1.5.5-.5.9-.8 1.5-1 .5-.2 1.2-.4 2.4-.4C8.4 2.2 8.8 2.2 12 2.2zm0 3.1a4.9 4.9 0 110 9.8 4.9 4.9 0 010-9.8zm0 1.8a3.1 3.1 0 100 6.2 3.1 3.1 0 000-6.2zm5.1-2.3a1.1 1.1 0 110 2.2 1.1 1.1 0 010-2.2z"
          />
        </svg>
        影片版 · Instagram
      </span>
      {
        caption && (
          <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-brand-brown">
            {caption}
          </p>
        )
      }
      <span class="mt-2 text-xs text-brand-brown transition group-hover:text-brand-orange">
        到 IG 看完整影片 ↗
      </span>
    </div>
  </a>
</figure>
