---
import { affiliatePlatforms } from "../data/linkClassification";

interface Props {
  pageContext?: Record<string, string | number | boolean>;
  bookingUrl?: string;
}

const { pageContext, bookingUrl } = Astro.props;
const GA_ID = "G-QFXNTWMX06";
---

<script
  is:inline
  async
  src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}
></script>

<script is:inline define:vars={{ GA_ID, pageContext, bookingUrl, affiliatePlatforms }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    window.dataLayer.push(arguments);
  }
  window.gtag = gtag;
  gtag("js", new Date());

  const ctx = pageContext || {};
  gtag("config", GA_ID, {
    send_page_view: false,
    ...ctx,
  });

  gtag("event", "page_view", { ...ctx });

  document.addEventListener("click", (e) => {
    const target = e.target instanceof Element ? e.target.closest("a") : null;
    if (!target || !target.href) return;

    const explicitEvent = target.dataset.gaEvent;

    if (explicitEvent) {
      gtag("event", explicitEvent, {
        ...ctx,
        source: target.dataset.gaLabel || target.getAttribute("aria-label") || "unknown",
        position: target.dataset.gaPosition || "unknown",
        target_url: target.href,
      });
      return;
    }

    // Auto-track outbound links inside article prose so links authored in
    // Keystatic (plain markdown) still show up in GA4. Internal and same-host
    // anchors are skipped. Host is classified so booking/affiliate clicks fire
    // distinct event names and show up separately in GA4 reports.
    const insideProse = target.closest(".prose");
    if (!insideProse) return;
    let url;
    try {
      url = new URL(target.href);
    } catch {
      return;
    }
    if (url.origin === window.location.origin) return;
    if (url.protocol !== "http:" && url.protocol !== "https:") return;

    const host = url.hostname.toLowerCase();
    const inAffiliateList = affiliatePlatforms.some(
      (p) => host === p || host.endsWith("." + p)
    );

    // Classification order matters:
    // 1. URL 剛好等於文章 frontmatter.deal.bookingUrl → booking_click
    //    （比對整個 URL，避免同一 host 的官方資訊頁被誤判）
    // 2. hostname 命中聯盟平台白名單 → affiliate_click
    // 3. 其他 → outbound_click
    const eventName =
      bookingUrl && target.href === bookingUrl
        ? "booking_click"
        : inAffiliateList
          ? "affiliate_click"
          : "outbound_click";

    gtag("event", eventName, {
      ...ctx,
      source: url.hostname,
      position: "article_body",
      target_url: target.href,
    });
  });

  // Scroll depth: fire once per threshold per page.
  const thresholds = [20, 50, 75, 100];
  const fired = new Set();
  function checkScroll() {
    const doc = document.documentElement;
    const scrollTop = window.scrollY || doc.scrollTop;
    const viewport = window.innerHeight || doc.clientHeight;
    const full = doc.scrollHeight;
    const scrollable = Math.max(1, full - viewport);
    const pct = Math.min(100, Math.round((scrollTop / scrollable) * 100));
    for (const t of thresholds) {
      if (pct >= t && !fired.has(t)) {
        fired.add(t);
        gtag("event", "scroll_depth", {
          ...ctx,
          percent: t,
        });
      }
    }
  }
  let ticking = false;
  window.addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        checkScroll();
        ticking = false;
      });
    },
    { passive: true }
  );
  // Initial check in case page is short enough to already be "fully viewed".
  checkScroll();
</script>
