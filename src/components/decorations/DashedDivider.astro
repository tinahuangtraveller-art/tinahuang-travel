---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<svg
  viewBox="0 0 400 6"
  class={`block h-1.5 w-full ${className}`}
  preserveAspectRatio="none"
  aria-hidden="true"
>
  <path
    d="M2 3 Q 100 1, 200 3 T 398 3"
    fill="none"
    stroke="var(--color-border-soft, #ead9c3)"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-dasharray="4 6"
  ></path>
</svg>
