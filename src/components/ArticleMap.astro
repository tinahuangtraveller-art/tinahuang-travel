---
interface Location {
  id: string;
  name: string;
  gmaps?: string;
  category?: "attraction" | "food" | "stay" | "transport";
  lat?: number;
  lng?: number;
}

interface Props {
  locations: Location[];
}

const { locations } = Astro.props;
const withCoords = locations.filter(
  (l) => typeof l.lat === "number" && typeof l.lng === "number"
);

if (withCoords.length === 0) {
  return;
}

const categoryIcon: Record<string, string> = {
  attraction: "📍",
  food: "🍽",
  stay: "🏨",
  transport: "🚉",
};
---

<section
  class="my-6 overflow-hidden rounded-2xl border border-border-soft bg-brand-cream"
  aria-labelledby="article-map-title"
>
  <div class="flex items-center justify-between gap-3 px-5 py-3 text-sm">
    <h2 id="article-map-title" class="font-bold text-brand-brown">
      🗺 這篇攻略的 {withCoords.length} 個景點
    </h2>
    <span class="text-[11px] text-ink-500">點 pin 看詳情</span>
  </div>

  <div
    class="article-map"
    data-locations={JSON.stringify(withCoords)}
    style="height: 300px;"
  >
  </div>

  <details class="border-t border-border-soft">
    <summary
      class="cursor-pointer px-5 py-3 text-sm text-brand-brown transition hover:bg-paper-soft"
    >
      📋 列表檢視
    </summary>
    <ul class="divide-y divide-border-soft">
      {
        withCoords.map((loc) => (
          <li class="flex items-center justify-between gap-3 px-5 py-3">
            <span class="flex items-center gap-2 text-sm text-brand-brown">
              <span aria-hidden="true">
                {categoryIcon[loc.category ?? "attraction"] ?? "📍"}
              </span>
              {loc.name}
            </span>
            {loc.gmaps && (
              <a
                href={loc.gmaps}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs text-brand-brown underline-offset-2 hover:underline"
              >
                開啟 Google Maps →
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </details>
</section>

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>

<script>
  import L from "leaflet";

  const containers = document.querySelectorAll<HTMLElement>(".article-map");

  containers.forEach((container) => {
    const raw = container.dataset.locations;
    if (!raw) return;

    const locations = JSON.parse(raw) as {
      id: string;
      name: string;
      gmaps?: string;
      category?: string;
      lat: number;
      lng: number;
    }[];

    if (locations.length === 0) return;

    const avgLat =
      locations.reduce((s, l) => s + l.lat, 0) / locations.length;
    const avgLng =
      locations.reduce((s, l) => s + l.lng, 0) / locations.length;

    const map = L.map(container, {
      center: [avgLat, avgLng],
      zoom: 13,
      scrollWheelZoom: false,
    });

    L.tileLayer(
      "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
      {
        attribution:
          '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
        maxZoom: 19,
      }
    ).addTo(map);

    const icon = L.divIcon({
      className: "custom-pin",
      html: `<span>📍</span>`,
      iconSize: [36, 36],
      iconAnchor: [18, 36],
      popupAnchor: [0, -32],
    });

    const bounds = L.latLngBounds([]);
    locations.forEach((loc, i) => {
      const numberedIcon = L.divIcon({
        className: "custom-pin",
        html: `<div class="pin-wrap"><span class="pin-num">${i + 1}</span></div>`,
        iconSize: [32, 32],
        iconAnchor: [16, 32],
        popupAnchor: [0, -30],
      });

      const marker = L.marker([loc.lat, loc.lng], { icon: numberedIcon }).addTo(
        map
      );
      const popupHtml = `
        <div class="map-popup">
          <strong>${i + 1}. ${loc.name}</strong>
          ${loc.gmaps ? `<br><a href="${loc.gmaps}" target="_blank" rel="noopener">開啟 Google Maps →</a>` : ""}
        </div>
      `;
      marker.bindPopup(popupHtml);
      bounds.extend([loc.lat, loc.lng]);
    });

    if (locations.length > 1) {
      map.fitBounds(bounds, { padding: [40, 40], maxZoom: 15 });
    }
  });
</script>

<style is:global>
  .leaflet-container {
    font-family: var(--font-sans);
    background: var(--color-paper-soft);
  }

  .custom-pin {
    background: transparent;
    border: none;
  }

  .custom-pin .pin-wrap {
    width: 32px;
    height: 32px;
    background: var(--color-brand-orange);
    border: 2px solid var(--color-brand-brown);
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
  }

  .custom-pin .pin-num {
    transform: rotate(45deg);
    color: var(--color-brand-brown);
    font-weight: 700;
    font-size: 12px;
  }

  .map-popup {
    font-size: 13px;
    color: var(--color-brand-brown);
    line-height: 1.6;
  }

  .map-popup a {
    color: var(--color-brand-brown);
    text-decoration: underline;
  }

  .leaflet-popup-content-wrapper {
    border-radius: 8px;
    background: var(--color-brand-cream);
  }

  .leaflet-popup-tip {
    background: var(--color-brand-cream);
  }
</style>
