---
interface Props {
  selector?: string;
  variant?: "sidebar" | "inline";
}

const { selector = ".prose", variant = "sidebar" } = Astro.props;
---

{
  variant === "sidebar" ? (
    <aside
      id="article-toc"
      data-toc-target={selector}
      class="hidden rounded-2xl border border-border-soft bg-brand-cream p-5"
      aria-label="文章目錄"
    >
      <h3 class="text-sm font-medium text-ink-500">📑 目錄</h3>
      <ol class="mt-3 space-y-2 text-sm leading-snug" />
    </aside>
  ) : (
    <details
      id="article-toc-inline"
      data-toc-target={selector}
      class="hidden group mt-6 rounded-2xl border border-border-soft bg-brand-cream open:bg-brand-cream"
    >
      <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-sm font-medium text-brand-brown">
        <span class="inline-flex items-center gap-2">
          <span aria-hidden="true">📑</span>目錄
        </span>
        <span class="text-xs text-ink-500 group-open:rotate-180 transition" aria-hidden="true">▾</span>
      </summary>
      <ol class="space-y-2 border-t border-border-soft px-4 py-3 text-sm leading-snug" />
    </details>
  )
}

<script>
  const buildToc = (root: HTMLElement) => {
    const selector = root.dataset.tocTarget || ".prose";
    const content = document.querySelector<HTMLElement>(selector);
    if (!content) return;

    const headings = Array.from(
      content.querySelectorAll<HTMLHeadingElement>("h2, h3")
    );
    if (headings.length < 3) return;

    const slugify = (text: string) =>
      text
        .trim()
        .toLowerCase()
        .replace(/\s+/g, "-")
        .replace(/[^\p{L}\p{N}-]/gu, "");

    const list = root.querySelector<HTMLOListElement>("ol");
    if (!list) return;

    const used = new Set<string>();
    headings.forEach((h) => {
      let id = h.id;
      if (!id) {
        id = slugify(h.textContent || "") || `heading-${used.size}`;
        let unique = id;
        let n = 1;
        while (used.has(unique)) unique = `${id}-${++n}`;
        id = unique;
        h.id = id;
      }
      used.add(id);

      const li = document.createElement("li");
      if (h.tagName === "H3") li.className = "pl-3";

      const a = document.createElement("a");
      a.href = `#${id}`;
      a.textContent = h.textContent || "";
      a.className =
        "block text-ink-700 hover:text-brand-orange transition line-clamp-2";
      a.dataset.tocLink = id;
      a.dataset.gaEvent = "toc_click";
      a.dataset.gaLabel = id;
      a.dataset.gaPosition = root.id === "article-toc" ? "sidebar" : "inline";

      li.appendChild(a);
      list.appendChild(li);
    });

    root.classList.remove("hidden");

    if (!("IntersectionObserver" in window)) return;
    const links = Array.from(
      root.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")
    );
    const byId = new Map(links.map((l) => [l.dataset.tocLink!, l]));

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const link = byId.get(e.target.id);
          if (!link) continue;
          if (e.isIntersecting) {
            links.forEach((l) =>
              l.classList.remove("text-brand-brown", "font-medium")
            );
            link.classList.add("text-brand-brown", "font-medium");
          }
        }
      },
      { rootMargin: "-20% 0px -70% 0px" }
    );
    headings.forEach((h) => io.observe(h));
  };

  document.querySelectorAll<HTMLElement>("[data-toc-target]").forEach(buildToc);
</script>
